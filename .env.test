# ---------------------------------------------------------------
# .env.test — safe placeholder values for CI / local test runs
# NEVER use real credentials here. This file CAN be committed.
# ---------------------------------------------------------------

DATABASE_URL=postgresql://core_user:core_pass@localhost:5434/core_server
JWT_ACCESS_SECRET=test-jwt-secret-at-least-32-characters-long!!
JWT_ACCESS_EXPIRY=15m
REFRESH_TOKEN_EXPIRY_DAYS=30
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000
BCRYPT_COST=4
PORT=0
NODE_ENV=test

# Email (no real SMTP needed for tests — nodemailer is never called in unit tests)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=test@example.com
SMTP_PASS=test-smtp-password

# Cloudinary (mocked in tests)
CLOUDINARY_CLOUD_NAME=test-cloud
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=test-api-secret-placeholder

# Admin Panel
ADMIN_SESSION_SECRET=test-admin-session-secret-at-least-32-chars!
ADMIN_EMAIL=admin@test.example.com
ADMIN_PASSWORD=TestAdmin1!

# Downstream services (not called in unit tests)
CONTEXT_SERVICE_URL=http://localhost:3001
GIS_SERVICE_URL=http://localhost:3002
RISK_SERVICE_URL=http://localhost:3004
AI_SERVICE_URL=http://localhost:3003
INTERNAL_API_KEY=test-internal-api-key-at-least-32-chars-long!!
EXCHANGE_RATES_API_KEY=
EXCHANGE_RATES_API_URL=https://api.exchangerate.host/latest
EXCHANGE_RATES_CACHE_TTL_SECONDS=900

# Paymob (not called in unit tests)
PAYMOB_SECRET_KEY=test-paymob-secret
PAYMOB_PUBLIC_KEY=test-paymob-public
PAYMOB_HMAC_SECRET=test-paymob-hmac
PAYMOB_CARD_INTEGRATION_ID=123456
PAYMOB_REDIRECTION_URL=http://localhost:3000/payment-result
PAYMOB_NOTIFICATION_URL=http://localhost:3000/api/payments/paymob/webhook
PAYMOB_API_BASE_URL=https://accept.paymob.com
