# ---------------------------------------------------------------
# .env.test — safe placeholder values for CI / local test runs
# NEVER use real credentials here. This file CAN be committed.
# ---------------------------------------------------------------

DATABASE_URL=postgresql://core_user:core_pass@localhost:5434/core_server_test
JWT_ACCESS_SECRET=test-jwt-secret-at-least-32-characters-long!!
JWT_ACCESS_EXPIRY=15m
REFRESH_TOKEN_EXPIRY_DAYS=30
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000
BCRYPT_COST=4
PORT=0
NODE_ENV=test

# Email (no real SMTP needed for tests — nodemailer is never called in unit tests)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=test@example.com
SMTP_PASS=test-smtp-password

# Cloudinary (mocked in tests)
CLOUDINARY_CLOUD_NAME=test-cloud
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=test-api-secret-placeholder

# Admin Panel
ADMIN_SESSION_SECRET=test-admin-session-secret-at-least-32-chars!
ADMIN_EMAIL=admin@test.example.com
ADMIN_PASSWORD=TestAdmin1!

# Downstream services (not called in unit tests)
CONTEXT_SERVICE_URL=http://localhost:3001
GIS_SERVICE_URL=http://localhost:3002
RISK_SERVICE_URL=http://localhost:3004
AI_SERVICE_URL=http://localhost:3003
INTERNAL_API_KEY=test-internal-api-key-at-least-32-chars-long!!
EXCHANGE_RATES_API_KEY=
EXCHANGE_RATES_API_URL=https://api.exchangerate.host/latest
EXCHANGE_RATES_CACHE_TTL_SECONDS=900

# Paymob (not called in unit tests)

# Paymob Integration
PAYMOB_SECRET_KEY=paymob_secret_key_here
PAYMOB_PUBLIC_KEY=paymob_public_key_here
PAYMOB_HMAC_SECRET=paymob_hmac_secret_here
PAYMOB_CARD_INTEGRATION_ID=123456
PAYMOB_REDIRECTION_URL=http://localhost:3000/api/payments/paymob/callback
PAYMOB_NOTIFICATION_URL=http://localhost:3000/api/payments/paymob/webhook
PAYMOB_API_BASE_URL=https://accept.paymob.com

# Phase 2G-B Wallet usage-based billing policy (locked defaults)
# One Wallet Token = WALLET_TOKEN_VALUE_NANO_USD nano-USD = 100 micro-USD = $0.0001
# Usage-based Wallet billing is the only live billing mode (legacy FIXED mode
# and its AI_WALLET_BILLING_MODE env var were removed in Phase 2G-B).
SIGNUP_TOKEN_GRANT=100
WALLET_TOKEN_VALUE_NANO_USD=100000
WALLET_MARKUP_BASIS_POINTS=10000
MINIMUM_WALLET_CHARGE=1
# Optional JSON per-feature reservation ceiling override (unset = default cap)
# AI_BILLING_MAX_RESERVATION_TOKENS={"AI_CHAT_QUERY":1000,"AI_IMAGE_ANALYSIS":1000,"AI_TRIP_ITINERARY":1000,"REAL_TIME_TRANSLATION":1000,"PERSONALIZED_RECOMMENDATIONS":1000,"OFFLINE_MAP_DOWNLOAD":1000,"SMART_BUDGET_PLANNER":1000,"LOCAL_AUDIO_GUIDE":1000,"BOOKING_PRICE_COMPARISON":1000}
