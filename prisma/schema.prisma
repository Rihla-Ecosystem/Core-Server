generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Gender {
  MALE
  FEMALE

  @@map("gender")
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
  REFUNDED
}

model TokenPackage {
  id Int @id @default(autoincrement())

  name        String
  description String?
  code        String  @unique
  price       Decimal @db.Decimal(10, 2)
  currency    String
  tokens      Int

  sortOrder Int @default(0)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments Payment[]
}

model Payment {
  id String @id @default(uuid()) @db.Uuid

  userId         String @db.Uuid
  tokenPackageId Int

  amount   Decimal       @db.Decimal(10, 2)
  currency String
  status   PaymentStatus @default(PENDING)

  packageNameSnapshot String
  tokensSnapshot      Int
  priceSnapshot       Decimal @db.Decimal(10, 2)
  currencySnapshot    String

  // Payment method
  provider              String  @default("PAYMOB")
  providerIntentionId   String? @unique
  providerOrderId       String?
  providerTransactionId String? @unique

  failureReason String?
  providerData  Json?

  paidAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  tokenTransactions TokenTransaction[]

  tokenPackage TokenPackage @relation(fields: [tokenPackageId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([tokenPackageId])
  @@index([status])
  @@index([status, createdAt])
}

enum WalletStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

model TokenWallet {
  id String @id @default(uuid()) @db.Uuid

  userId          String @unique @db.Uuid
  tokenBalance    Int    @default(0)
  reservedBalance Int    @default(0)

  status WalletStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  transactions TokenTransaction[]
  reservations TokenReservation[]
}

enum TokenReservationStatus {
  PENDING
  COMPLETED
  RELEASED
}

model TokenReservation {
  id String @id @default(uuid()) @db.Uuid

  walletId String @db.Uuid
  userId   String @db.Uuid

  feature String
  source  TokenTransactionSource

  tokens Int

  pricingVersion Int @default(1)

  idempotencyKey String

  referenceId String

  status TokenReservationStatus @default(PENDING)

  expiresAt  DateTime
  settledAt  DateTime?
  releasedAt DateTime?

  releaseReason String?

  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  wallet TokenWallet @relation(fields: [walletId], references: [id], onDelete: Restrict)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  billingOperation AIBillingOperation?

  @@unique([referenceId])
  @@unique([userId, feature, idempotencyKey])
  @@index([walletId])
  @@index([userId])
  @@index([status])
  @@index([expiresAt])
  @@index([userId, status])
}

enum AIBillingOperationStatus {
  RESERVED
  EXECUTION_SUCCEEDED
  PRICED
  NON_BILLABLE_CONFIRMED
  INDETERMINATE
  REVIEW_REQUIRED
  SETTLED
  RELEASED
}

enum AIBillingOperationFailureKind {
  NON_BILLABLE
  INDETERMINATE
}

model AIBillingOperation {
  id String @id @default(uuid()) @db.Uuid

  operationId String @unique

  reservationId String @unique @db.Uuid

  walletId String @db.Uuid
  userId   String @db.Uuid

  feature String
  source  TokenTransactionSource

  status AIBillingOperationStatus @default(RESERVED)

  // Immutable reservation snapshot
  reservedTokens            Int
  reservationPricingVersion Int

  // Requested identity
  requestedProvider String?
  requestedModel    String?

  // Actual execution identity evidence
  actualProvider      String?
  actualModel         String?
  providerRequestId   String?
  providerRequestSent Boolean?

  // Canonical usage evidence
  inputTokens  Int?
  outputTokens Int?
  totalTokens  Int?
  cached       Boolean?
  audioSeconds Float?

  // Pricing evidence (safe subset only)
  pricingMode           String?
  pricingFallbackReason String?
  actualWalletTokens    Int?
  billingCurrency       String?
  rateCardVersion       String?
  walletPolicyVersion   String?

  // Failure evidence
  failureKind AIBillingOperationFailureKind?
  failureCode String?
  retryable   Boolean?

  // Review evidence
  reviewReasonCode String?

  // Finalization evidence
  consumeTransactionId String?

  // Lifecycle timestamps
  executedAt DateTime?
  pricedAt   DateTime?
  failedAt   DateTime?
  reviewedAt DateTime?
  settledAt  DateTime?
  releasedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reservation TokenReservation @relation(fields: [reservationId], references: [id], onDelete: Restrict)

  @@index([status, updatedAt])
  @@index([walletId, status])
  @@index([userId, createdAt])
  @@map("AIBillingOperation")
}

enum TokenTransactionType {
  GRANT
  CONSUME
  REFUND
  BONUS
  ADJUSTMENT
}

enum TokenTransactionSource {
  CHAT
  IMAGE
  FILE_UPLOAD
  OCR
  VOICE
  ITINERARY
  PURCHASE
  ADMIN
}

model TokenTransaction {
  id String @id @default(uuid()) @db.Uuid

  walletId String @db.Uuid
  userId   String @db.Uuid

  type TokenTransactionType

  tokens Int

  source TokenTransactionSource

  paymentId String? @db.Uuid

  referenceId String?
  metadata    Json?

  createdAt DateTime @default(now())

  wallet TokenWallet @relation(fields: [walletId], references: [id], onDelete: Restrict)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@unique([source, referenceId])
  @@index([userId, createdAt])
  @@index([userId])
  @@index([walletId])
  @@index([type])
  @@index([paymentId])
  @@index([createdAt])
  @@index([source])
}

model Role {
  id          Int    @id @default(autoincrement())
  name        String @unique @db.VarChar(50)
  permissions Json   @default("[]")
  users       User[]

  @@map("roles")
}

model User {
  id                String    @id @default(uuid()) @db.Uuid
  email             String    @unique @db.VarChar(255)
  passwordHash      String    @map("password_hash") @db.VarChar(255)
  displayName       String    @map("display_name") @db.VarChar(100)
  avatarUrl         String?   @map("avatar_url") @db.Text
  bio               String?   @db.Text
  gender            Gender    @map("gender")
  nationality       String    @db.VarChar(100)
  language          Json      @default("[]") @map("languages")
  budgetLevel       String?   @map("budget_level") @db.VarChar(50)
  arrivalDate       DateTime? @map("arrival_date") @db.Date
  departureDate     DateTime? @map("departure_date") @db.Date
  travelStyle       String?   @map("travel_style") @db.VarChar(50)
  interests         Json?     @default("[]") @map("interests")
  accommodationType String?   @map("accommodation_type") @db.VarChar(50)
  roleId            Int       @default(1) @map("role_id")
  isEmailVerified   Boolean   @default(false) @map("is_email_verified")
  isActive          Boolean   @default(true) @map("is_active")
  isBanned          Boolean   @default(false) @map("is_banned")

  // Soft Delete
  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  xp          Int       @default(0)
  level       Int       @default(1)
  lastLoginAt DateTime? @map("last_login_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  role                    Role                     @relation(fields: [roleId], references: [id])
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  refreshTokens           RefreshToken[]
  userBadges              UserBadge[]
  xpTransactions          XpTransaction[]
  auditLogsAsActor        AuditLog[]               @relation("ActorAuditLogs")
  auditLogsAsTarget       AuditLog[]               @relation("TargetAuditLogs")
  conversations           Conversation[]
  tripHistories           TripHistory[]
  userPreferences         UserPreference[]
  userFeedbacks           UserFeedback[]
  interactionSummaries    InteractionSummary[]
  payments                Payment[]
  tokenWallet             TokenWallet?
  tokenTransactions       TokenTransaction[]
  tokenReservations       TokenReservation[]
  journeyProgress         UserJourney[]
  aiUsageLogs             AiUsageLog[]

  @@map("users")
}

model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @map("token_hash") @db.VarChar(255)
  deviceInfo String?   @map("device_info") @db.Text
  ipAddress  String?   @map("ip_address") @db.VarChar(45)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Badge {
  id            Int         @id @default(autoincrement())
  name          String      @unique @db.VarChar(100)
  description   String?     @db.Text
  iconUrl       String?     @map("icon_url") @db.Text
  criteriaType  String      @map("criteria_type") @db.VarChar(50)
  criteriaValue Int?        @map("criteria_value")
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz
  userBadges    UserBadge[]

  @@map("badges")
}

model UserBadge {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  badgeId   Int      @map("badge_id")
  awardedAt DateTime @default(now()) @map("awarded_at") @db.Timestamptz

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@map("user_badges")
}

model XpTransaction {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  amount    Int
  reason    String   @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("xp_transactions")
}

model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  actorId      String?  @map("actor_id") @db.Uuid
  action       String   @db.VarChar(100)
  targetUserId String?  @map("target_user_id") @db.Uuid
  metadata     Json?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  actor  User? @relation("ActorAuditLogs", fields: [actorId], references: [id])
  target User? @relation("TargetAuditLogs", fields: [targetUserId], references: [id])

  @@map("audit_logs")
}

model Conversation {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  title     String?  @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([userId])
  @@map("conversations")
}

model Message {
  id             String   @id @default(uuid()) @db.Uuid
  conversationId String   @map("conversation_id") @db.Uuid
  role           String   @db.VarChar(20)
  content        String   @db.Text
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("messages")
}

model TripHistory {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  title       String   @db.VarChar(255)
  destination String   @db.VarChar(255)
  startDate   DateTime @map("start_date") @db.Date
  endDate     DateTime @map("end_date") @db.Date
  itinerary   Json?
  notes       String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("trip_histories")
}

model UserPreference {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  key       String   @db.VarChar(100)
  value     Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@map("user_preferences")
}

model UserFeedback {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  type       String   @db.VarChar(50)
  targetId   String?  @map("target_id") @db.Uuid
  targetType String?  @map("target_type") @db.VarChar(50)
  rating     Int?
  comment    String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_feedback")
}

model InteractionSummary {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  summary     String   @db.Text
  periodStart DateTime @map("period_start") @db.Timestamptz
  periodEnd   DateTime @map("period_end") @db.Timestamptz
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("interaction_summaries")
}

model Journey {
  id          String        @id @default(uuid()) @db.Uuid
  slug        String        @unique @db.VarChar(100)
  title       String        @db.VarChar(255)
  description String?       @db.Text
  xpReward    Int           @default(0) @map("xp_reward")
  isActive    Boolean       @default(true) @map("is_active")
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz
  steps       JourneyStep[]
  progress    UserJourney[]

  @@map("journeys")
}

model JourneyStep {
  id          String            @id @default(uuid()) @db.Uuid
  journeyId   String            @map("journey_id") @db.Uuid
  stepNumber  Int               @map("step_number")
  title       String            @db.VarChar(255)
  content     String            @db.Text
  xpReward    Int               @default(0) @map("xp_reward")
  journey     Journey           @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  completions UserJourneyStep[]

  @@unique([journeyId, stepNumber])
  @@index([journeyId])
  @@map("journey_steps")
}

model UserJourney {
  id          String            @id @default(uuid()) @db.Uuid
  userId      String            @map("user_id") @db.Uuid
  journeyId   String            @map("journey_id") @db.Uuid
  startedAt   DateTime          @default(now()) @map("started_at") @db.Timestamptz
  completedAt DateTime?         @map("completed_at") @db.Timestamptz
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  journey     Journey           @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  steps       UserJourneyStep[]

  @@unique([userId, journeyId])
  @@index([userId])
  @@map("user_journeys")
}

model UserJourneyStep {
  id            String      @id @default(uuid()) @db.Uuid
  userJourneyId String      @map("user_journey_id") @db.Uuid
  stepId        String      @map("step_id") @db.Uuid
  completedAt   DateTime    @default(now()) @map("completed_at") @db.Timestamptz
  userJourney   UserJourney @relation(fields: [userJourneyId], references: [id], onDelete: Cascade)
  step          JourneyStep @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@unique([userJourneyId, stepId])
  @@index([userJourneyId])
  @@map("user_journey_steps")
}

model AiUsageLog {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  conversationId String?   @map("conversation_id") @db.Uuid
  source         String    @default("chat") @db.VarChar(20)
  model          String?   @db.VarChar(100)
  inputTokens    Int       @default(0) @map("input_tokens")
  outputTokens   Int       @default(0) @map("output_tokens")
  totalTokens    Int       @default(0) @map("total_tokens")
  cost           Decimal   @default(0) @db.Decimal(12, 6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([createdAt])
  @@index([source])
  @@map("ai_usage_logs")
}

// ---------------------------------------------------------------------------
// Phase 2F-A — versioned provider rate-card snapshots
// ---------------------------------------------------------------------------
// A snapshot is an immutable, versioned copy of the provider-neutral rate card
// (`ProviderRateCard` in src/types/provider-pricing.ts). A card edit produces a
// new snapshot version; the active snapshot is materialized at read time.
//
// Monetary rate columns are PostgreSQL BIGINT / Prisma BigInt so the database
// can store values larger than Number.MAX_SAFE_INTEGER exactly. The pricing
// engine contract still consumes safe JS numbers, so the pure mapper enforces
// a bigint-to-number range check at the DB boundary (see
// src/utils/provider-pricing/snapshot.ts); the database never loses precision.
//
// Snapshot lifecycle is DRAFT / ACTIVE / RETIRED (immutable financial
// snapshots). Lifecycle and monetary CHECK constraints are added manually in
// the migration SQL; the pure validator enforces complete domain coherence.

enum ProviderRateCardSnapshotStatus {
  DRAFT
  ACTIVE
  RETIRED

  @@map("provider_rate_card_snapshot_status")
}

enum ProviderRateCardEntryStatus {
  STABLE
  PREVIEW
  DEPRECATED
  LIMITED_AVAILABILITY

  @@map("provider_rate_card_entry_status")
}

enum ProviderRateCardTier {
  STANDARD
  BATCH
  PRIORITY
  FAST_MODE

  @@map("provider_rate_card_tier")
}

enum ProviderRateCardBillingUnit {
  TOKEN
  IMAGE
  SECOND
  MINUTE
  CHARACTER

  @@map("provider_rate_card_billing_unit")
}

enum CachedInputAccountingSemantic {
  DISJOINT
  INCLUDED_IN_INPUT

  @@map("cached_input_accounting_semantic")
}

model ProviderRateCardSnapshot {
  id      String                         @id @default(uuid()) @db.Uuid
  version String                         @unique
  status  ProviderRateCardSnapshotStatus @default(DRAFT)

  schemaVersion Int    @default(1)
  currency      String @default("USD")
  storageUnit   String @default("MICROS")
  engineUnit    String @default("NANO_USD")

  // Research/source pricing snapshot date (immutable, always present).
  source      String
  generatedAt DateTime @db.Date
  provenance  String   @default("RESEARCH_SNAPSHOT")

  // Business validity window for selecting the snapshot (date precision).
  // Nullable while the draft is unfinished.
  effectiveFrom DateTime? @db.Date
  effectiveTo   DateTime? @db.Date

  // Lifecycle publication timestamps (timestamp precision).
  // publishedAt: when the draft was formally published.
  // retiredAt:   when the published snapshot was retired.
  publishedAt DateTime? @db.Timestamptz
  retiredAt   DateTime? @db.Timestamptz

  entries ProviderRateCardEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([status, effectiveFrom, effectiveTo])
  @@map("ProviderRateCardSnapshot")
}

model ProviderRateCardEntry {
  id         String @id @default(uuid()) @db.Uuid
  snapshotId String @db.Uuid

  provider String
  model    String

  status      ProviderRateCardEntryStatus
  // Non-null so PostgreSQL uniqueness never treats multiple NULL tiers as
  // distinct: the engine default tier maps to STANDARD at persistence time.
  tier        ProviderRateCardTier   @default(STANDARD)
  billingUnit ProviderRateCardBillingUnit

  // Monetary rates in integer micro-USD per 1M units. BIGINT so the DB stores
  // exact integer values beyond Number.MAX_SAFE_INTEGER without loss.
  inputMicrosPerMillion        BigInt?
  outputMicrosPerMillion       BigInt?
  cachedInputMicrosPerMillion  BigInt?
  cachedOutputMicrosPerMillion BigInt?
  perUnitMicros                BigInt?
  audioInputMicrosPerMillion   BigInt?
  audioOutputMicrosPerMillion  BigInt?

  // Conversion ratio, not money. Kept as a finite numeric field with a
  // positive-value CHECK constraint in the migration.
  tokensPerSecond Float?

  cachedInputAccounting CachedInputAccountingSemantic?

  aliases Json?

  effectiveFrom DateTime  @db.Date
  effectiveTo   DateTime? @db.Date

  inactive Boolean @default(false)

  source     String?
  verifiedAt DateTime? @db.Date

  snapshot ProviderRateCardSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Full entry lookup identity inside one snapshot, aligned with the Pricing
  // Engine resolveRate lookup (provider + model/alias + tier + effective
  // window). billingUnit is NOT a resolution dimension, so it is excluded:
  // a snapshot must not persist two lines the engine could not distinguish.
  // Historical protection: RESTRICT, never CASCADE.
  @@unique([snapshotId, provider, model, tier])
  @@index([snapshotId])
  @@index([provider, model, status])
  @@map("ProviderRateCardEntry")
}
