## 3. Database Schema (PostgreSQL DDL)

```sql
-- Extensions
CREATE EXTENSION IF NOT EXISTS pgcrypto;

-- Gender enum
CREATE TYPE gender AS ENUM ('MALE', 'FEMALE');

-- ROLES
CREATE TABLE roles (
  id SERIAL PRIMARY KEY,
  name VARCHAR(50) UNIQUE NOT NULL,        -- 'user', 'moderator', 'admin'
  permissions JSONB NOT NULL DEFAULT '[]'  -- e.g. ["users:read","users:ban"]
);

INSERT INTO roles (name, permissions) VALUES
  ('user', '[]'),
  ('moderator', '["users:read","content:moderate"]'),
  ('admin', '["users:read","users:write","users:ban","roles:assign"]');

-- USERS
CREATE TABLE users (
  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  email VARCHAR(255) UNIQUE NOT NULL,
  password_hash VARCHAR(255) NOT NULL,
  display_name VARCHAR(100) NOT NULL,
  avatar_url TEXT,
  bio TEXT,
  gender GENDER NOT NULL,                          -- tourist assistance
  nationality VARCHAR(100) NOT NULL,
  languages JSONB NOT NULL DEFAULT '[]',            -- e.g. ["en","ar"]
  budget_level VARCHAR(50),                         -- 'budget' | 'mid-range' | 'luxury'
  arrival_date DATE,
  departure_date DATE,
  travel_style VARCHAR(50),                         -- 'solo' | 'couple' | 'family' | 'group'
  interests JSONB DEFAULT '[]',                     -- e.g. ["historical","beach"]
  accommodation_type VARCHAR(50),                   -- 'hotel' | 'hostel' | 'apartment' | 'resort'
  role_id INT NOT NULL REFERENCES roles(id) DEFAULT 1,
  is_email_verified BOOLEAN NOT NULL DEFAULT FALSE,
  is_active BOOLEAN NOT NULL DEFAULT TRUE,
  is_banned BOOLEAN NOT NULL DEFAULT FALSE,
  xp INT NOT NULL DEFAULT 0,
  level INT NOT NULL DEFAULT 1,
  last_login_at TIMESTAMPTZ,
  created_at TIMESTAMPTZ NOT NULL DEFAULT now(),
  updated_at TIMESTAMPTZ NOT NULL DEFAULT now()
);
CREATE INDEX idx_users_email ON users(email);

-- EMAIL VERIFICATION TOKENS
CREATE TABLE email_verification_tokens (
  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  user_id UUID NOT NULL REFERENCES users(id) ON DELETE CASCADE,
  token_hash VARCHAR(255) NOT NULL,
  expires_at TIMESTAMPTZ NOT NULL,
  used_at TIMESTAMPTZ,
  created_at TIMESTAMPTZ NOT NULL DEFAULT now()
);
CREATE INDEX idx_evt_user ON email_verification_tokens(user_id);

-- PASSWORD RESET TOKENS
CREATE TABLE password_reset_tokens (
  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  user_id UUID NOT NULL REFERENCES users(id) ON DELETE CASCADE,
  token_hash VARCHAR(255) NOT NULL,
  expires_at TIMESTAMPTZ NOT NULL,
  used_at TIMESTAMPTZ,
  created_at TIMESTAMPTZ NOT NULL DEFAULT now()
);
CREATE INDEX idx_prt_user ON password_reset_tokens(user_id);

-- REFRESH TOKENS (sessions)
CREATE TABLE refresh_tokens (
  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  user_id UUID NOT NULL REFERENCES users(id) ON DELETE CASCADE,
  token_hash VARCHAR(255) NOT NULL,
  device_info TEXT,
  ip_address VARCHAR(45),
  expires_at TIMESTAMPTZ NOT NULL,
  revoked_at TIMESTAMPTZ,
  created_at TIMESTAMPTZ NOT NULL DEFAULT now()
);
CREATE INDEX idx_rt_user ON refresh_tokens(user_id);

-- BADGES
CREATE TABLE badges (
  id SERIAL PRIMARY KEY,
  name VARCHAR(100) UNIQUE NOT NULL,
  description TEXT,
  icon_url TEXT,
  criteria_type VARCHAR(50) NOT NULL,   -- 'xp_threshold' | 'action_count' | 'manual'
  criteria_value INT,
  created_at TIMESTAMPTZ NOT NULL DEFAULT now()
);

CREATE TABLE user_badges (
  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  user_id UUID NOT NULL REFERENCES users(id) ON DELETE CASCADE,
  badge_id INT NOT NULL REFERENCES badges(id) ON DELETE CASCADE,
  awarded_at TIMESTAMPTZ NOT NULL DEFAULT now(),
  UNIQUE(user_id, badge_id)
);

-- XP TRANSACTIONS (audit trail of every XP change)
CREATE TABLE xp_transactions (
  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  user_id UUID NOT NULL REFERENCES users(id) ON DELETE CASCADE,
  amount INT NOT NULL,
  reason VARCHAR(100) NOT NULL,   -- 'daily_login','email_verified','message_sent',...
  created_at TIMESTAMPTZ NOT NULL DEFAULT now()
);
CREATE INDEX idx_xp_user ON xp_transactions(user_id);

-- AUDIT LOG (admin actions)
CREATE TABLE audit_logs (
  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  actor_id UUID REFERENCES users(id),
  action VARCHAR(100) NOT NULL,        -- 'role_changed','user_banned',...
  target_user_id UUID REFERENCES users(id),
  metadata JSONB,
  created_at TIMESTAMPTZ NOT NULL DEFAULT now()
);

-- MEMORY (long-term, per-user conversation history for the AI system)
CREATE TABLE conversations (
  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  user_id UUID NOT NULL REFERENCES users(id) ON DELETE CASCADE,
  title VARCHAR(255),
  created_at TIMESTAMPTZ NOT NULL DEFAULT now(),
  updated_at TIMESTAMPTZ NOT NULL DEFAULT now()
);
CREATE INDEX idx_conv_user ON conversations(user_id);

CREATE TABLE messages (
  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  conversation_id UUID NOT NULL REFERENCES conversations(id) ON DELETE CASCADE,
  role VARCHAR(20) NOT NULL,       -- 'user' | 'assistant' | 'system'
  content TEXT NOT NULL,
  created_at TIMESTAMPTZ NOT NULL DEFAULT now()
);
CREATE INDEX idx_msg_conversation ON messages(conversation_id);
```

**Notes:**
- Every token table stores a **hash** of the token, never the raw value — if the DB leaks, tokens can't be reused.
- Short-term memory (current chat context) lives in application memory / passed in the request — it does **not** need its own table. Only persisted history goes to `conversations` / `messages`.
- `messages` here is your relational source of truth. If you also embed messages into the vector DB for semantic recall, store the `message.id` alongside the embedding so you can trace back to source.

