DATABASE_URL=postgresql://core_user:core_pass@localhost:5432/core_server
JWT_ACCESS_SECRET=change-me-to-a-random-256-bit-string
JWT_ACCESS_EXPIRY=15m
REFRESH_TOKEN_EXPIRY_DAYS=30
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000
BCRYPT_COST=12
PORT=3000

# Nodemailer (Gmail app password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
EMAIL_FROM=ITI Hub <noreply@itihub.com>

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Admin Panel
ADMIN_EMAIL=admin@itihub.com
ADMIN_PASSWORD=Admin123!
ADMIN_SESSION_SECRET=change-me-to-a-long-secret-at-least-32-chars

