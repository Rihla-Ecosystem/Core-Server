DATABASE_URL=postgresql://core_user:core_pass@localhost:5432/core_server
JWT_ACCESS_SECRET=change-me-to-a-random-256-bit-string
JWT_ACCESS_EXPIRY=15m
REFRESH_TOKEN_EXPIRY_DAYS=30
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000
BCRYPT_COST=12
PORT=3000

# Nodemailer (Gmail app password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
EMAIL_FROM=ITI Hub <noreply@itihub.com>

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Admin Panel
ADMIN_SESSION_SECRET=change-me-to-a-long-secret-at-least-32-chars
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# Downstream services
CONTEXT_SERVICE_URL=http://context-service:3001
GIS_SERVICE_URL=http://gis-service:3002
RISK_SERVICE_URL=http://risk-intelligence:3000
AI_SERVICE_URL=http://ai-service:3003
INTERNAL_API_KEY=replace-with-a-random-internal-key-at-least-32-characters
EXCHANGE_RATES_API_KEY=
WEATHER_SERVICE_URL=
AIR_QUALITY_SERVICE_URL=
PRAYER_TIMES_SERVICE_URL=

# Paymob Integration
PAYMOB_SECRET_KEY=paymob_secret_key_here
PAYMOB_PUBLIC_KEY=paymob_public_key_here
PAYMOB_HMAC_SECRET=paymob_hmac_secret_here
PAYMOB_CARD_INTEGRATION_ID=123456
PAYMOB_REDIRECTION_URL=http://localhost:3000/api/payments/paymob/callback
PAYMOB_NOTIFICATION_URL=http://localhost:3000/api/payments/paymob/webhook
PAYMOB_API_BASE_URL=https://accept.paymob.com

# Chat Limits (Rihla application-level defaults; not official Gemini model limits)
CHAT_MAX_INPUT_TOKENS=12000
CHAT_MAX_CURRENT_MESSAGE_TOKENS=3000
CHAT_MAX_MESSAGE_CHARACTERS=10000
CHAT_MAX_RECENT_MESSAGES=10
CHAT_HISTORY_TOKEN_BUDGET=5500
CHAT_SUMMARY_TOKEN_BUDGET=1000
CHAT_MAX_OUTPUT_TOKENS=1200

# Provider Rate Card pricing source (Phase 2G-B authoritative rate card).
#   STATIC          — static rate card is authoritative (default; used for billing).
#   DATABASE_SHADOW — database rate card loaded for shadow comparison only; static
#                     remains authoritative for billing.
#   DATABASE_PRIMARY — database rate card is the authoritative billing source.
# Malformed / empty / unknown values resolve to STATIC (fail closed).
PROVIDER_RATE_CARD_PRICING_SOURCE=DATABASE_PRIMARY
# Optional DB shadow comparison for the static card (observability only).
PROVIDER_RATE_CARD_DB_SHADOW_ENABLED=false

# Phase 2G-A Wallet usage-based billing policy. Legacy FIXED billing was removed
# in Phase 2G-B; usage-based Wallet billing is the only live billing path.
# One Wallet Token = WALLET_TOKEN_VALUE_NANO_USD nano-USD (100000 = $0.0001).
WALLET_TOKEN_VALUE_NANO_USD=100000
# Markup applied once per billing operation (10000 basis points = 1.00x, no markup).
WALLET_MARKUP_BASIS_POINTS=10000
# Minimum charge in tokens for fully-priced positive-cost zero-round results.
MINIMUM_WALLET_CHARGE=1
# Optional JSON map { feature: positive int } overriding per-feature reservation caps.
# Example: {"AI_CHAT_QUERY":1000,"AI_IMAGE_ANALYSIS":1000}
AI_BILLING_MAX_RESERVATION_TOKENS=
